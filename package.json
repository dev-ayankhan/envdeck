{
  "author": {
    "email": "dev.ayankhan@gmail.com",
    "name": "Ayan",
    "url": "https://ayankhan.co.in"
  },
  "name": "envdeck",
  "version": "1.0.2",
  "description": "Production-grade environment variable management with runtime validation for JavaScript and TypeScript. Safely validate, parse, and manage environment variables across runtimes with dotenv compatibility and modern framework support.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "envdeck": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-ayankhan/envdeck.git"
  },
  "homepage": "https://github.com/dev-ayankhan/envdeck#readme",
  "bugs": {
    "url": "https://github.com/dev-ayankhan/envdeck/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.mjs",
      "require": "./dist/runtime/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "env",
    "dotenv",
    "environment variables",
    "config",
    "configuration",
    "validation",
    "runtime validation",
    "type-safe",
    "type-safe config",
    "environment config",
    "config management",
    "dotenv alternative",
    "schema validation",
    "environment configuration",
    "production config",
    "safe config",
    "typescript",
    "javascript",
    "cross-platform config",
    "framework config",
    "vite env",
    "nextjs env"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^10.0.0",
    "jiti": "^1.21.0",
    "ora": "^9.4.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.21.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.2",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^8.57.1",
    "prettier": "^3.1.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
